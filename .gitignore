# OS
.DS_Store

# Python local build/test artifacts
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Orbital 官方源码快照（只读参考，55MB，不进交付 repo — 见 orbital/INDEX.md）
orbital-src/

# Orbital 机器管理的运行时数据（session/ledger/tool output 不进交付 repo — 见 SPEC-09）
orbital/sessions/
orbital/ledger/
orbital/tool-results/
orbital/output/
orbital/queue.json
orbital/approval_history.jsonl
# sub_agents 下只有各 agent 的 MEMORY.md 是版本化交付文件（DECISIONS D10）
orbital/sub_agents/*/*
!orbital/sub_agents/*/MEMORY.md
